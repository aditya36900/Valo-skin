#!/usr/bin/env python3
"""valo-uplink: KDE Connect bridge for the Valo-skin shell ("Uplink").

    valo-uplink status                 JSON: daemon state + every known device
    valo-uplink ring|ping ID           find my phone / ping
    valo-uplink share ID FILE...       send files
    valo-uplink pickshare ID           pick files (kdialog/zenity) and send them
    valo-uplink screenshot ID          grab the screen (grim) and send it
    valo-uplink clipboard ID           push the desktop clipboard to the phone
    valo-uplink browse ID              mount the phone's storage (SFTP) and open it
    valo-uplink sms ID NUMBER TEXT     send an SMS through the phone
    valo-uplink pair|unpair ID

Talks to kdeconnectd over D-Bus with busctl (always present with systemd) and falls back to
kdeconnect-cli. Only uses the Python standard library.
"""

import json
import os
import shutil
import subprocess
import sys
import tempfile
import time

BUS = "org.kde.kdeconnect"
ROOT = "/modules/kdeconnect"


def run(cmd, timeout=8):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout
    except (OSError, subprocess.SubprocessError):
        return 1, ""


def busctl(*args):
    code, out = run(["busctl", "--user", "--json=short", *args])
    if code != 0 or not out.strip():
        return None
    try:
        return json.loads(out).get("data")
    except ValueError:
        return None


def prop(path, iface, name):
    return busctl("get-property", BUS, path, iface, name)


def device_ids():
    data = busctl("call", BUS, ROOT, "org.kde.kdeconnect.daemon", "devices", "bb", "false", "false")
    if data is not None:
        return data[0] if data and isinstance(data[0], list) else data
    if shutil.which("kdeconnect-cli"):
        code, out = run(["kdeconnect-cli", "-a", "--id-only"])
        if code == 0:
            return [line.strip() for line in out.splitlines() if line.strip()]
    return None


def device(did):
    path = f"{ROOT}/devices/{did}"
    iface = "org.kde.kdeconnect.device"
    paired = prop(path, iface, "isPaired")
    if paired is None:
        paired = prop(path, iface, "isTrusted")  # renamed in newer KDE Connect
    d = {
        "id": did,
        "name": prop(path, iface, "name") or did,
        "type": prop(path, iface, "type") or "phone",
        "reachable": bool(prop(path, iface, "isReachable")),
        "paired": bool(paired),
        "battery": -1,
        "charging": False,
        "network": "",
        "signal": -1,
    }
    if d["reachable"] and d["paired"]:
        charge = prop(f"{path}/battery", "org.kde.kdeconnect.device.battery", "charge")
        if isinstance(charge, int):
            d["battery"] = charge
            d["charging"] = bool(prop(f"{path}/battery", "org.kde.kdeconnect.device.battery", "isCharging"))
        conn = f"{path}/connectivity_report"
        net = prop(conn, "org.kde.kdeconnect.device.connectivity_report", "cellularNetworkType")
        if isinstance(net, str):
            d["network"] = net
            strength = prop(conn, "org.kde.kdeconnect.device.connectivity_report", "cellularNetworkStrength")
            d["signal"] = strength if isinstance(strength, int) else -1
    return d


def status():
    installed = bool(shutil.which("kdeconnectd") or shutil.which("kdeconnect-cli")
                     or os.path.exists("/usr/libexec/kdeconnectd") or os.path.exists("/usr/lib/kdeconnectd"))
    ids = device_ids()
    out = {"installed": installed, "running": ids is not None, "devices": [], "time": int(time.time())}
    if ids:
        out["devices"] = sorted((device(i) for i in ids), key=lambda d: (not d["reachable"], not d["paired"], d["name"]))
    print(json.dumps(out))
    return 0


def cli(did, *args):
    if not shutil.which("kdeconnect-cli"):
        print("kdeconnect-cli not found", file=sys.stderr)
        return 1
    code, _ = run(["kdeconnect-cli", "-d", did, *args], timeout=30)
    return code


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd = argv[1]
    if cmd == "status":
        return status()
    if len(argv) < 3:
        print(f"valo-uplink {cmd}: device id required", file=sys.stderr)
        return 2
    did = argv[2]
    if cmd == "ring":
        return cli(did, "--ring")
    if cmd == "ping":
        return cli(did, "--ping-msg", "Valo-skin uplink check")
    if cmd == "share":
        return max([cli(did, "--share", f) for f in argv[3:]] or [2])
    if cmd == "pickshare":
        files = []
        if shutil.which("kdialog"):
            code, out = run(["kdialog", "--multiple", "--separate-output", "--getopenfilename",
                             os.path.expanduser("~")], timeout=600)
            files = [f for f in out.splitlines() if f]
        elif shutil.which("zenity"):
            code, out = run(["zenity", "--file-selection", "--multiple", "--separator=\n"], timeout=600)
            files = [f for f in out.splitlines() if f]
        else:
            print("valo-uplink: install kdialog or zenity to pick files", file=sys.stderr)
            return 1
        return max([cli(did, "--share", f) for f in files] or [1])
    if cmd == "screenshot":
        shot = os.path.join(tempfile.gettempdir(), f"valo-shot-{int(time.time())}.png")
        code, _ = run(["grim", shot], timeout=15)
        return cli(did, "--share", shot) if code == 0 else code
    if cmd == "clipboard":
        code, text = run(["wl-paste", "--no-newline"])
        if code != 0:
            return code
        # newer kdeconnect-cli has --send-clipboard; older ones can share text
        if "--send-clipboard" in run(["kdeconnect-cli", "--help"])[1]:
            return cli(did, "--send-clipboard")
        return cli(did, "--share-text", text)
    if cmd == "browse":
        cli(did, "--mount")
        code, out = run(["kdeconnect-cli", "-d", did, "--get-mount-point"], timeout=20)
        path = out.strip()
        if code != 0 or not path:
            return 1
        subprocess.Popen(["xdg-open", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return 0
    if cmd == "sms" and len(argv) >= 5:
        return cli(did, "--send-sms", " ".join(argv[4:]), "--destination", argv[3])
    if cmd == "pair":
        return cli(did, "--pair")
    if cmd == "unpair":
        return cli(did, "--unpair")
    print(f"valo-uplink: unknown command {cmd!r}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
