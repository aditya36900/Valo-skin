#!/usr/bin/env python3
"""Downloads Valorant agent artwork for the Valo-skin wallpapers.

Valo-skin doesn't ship any Riot Games artwork. This fetches each agent's full portrait (and the
stylised name art behind it) from the community valorant-api.com service into
~/.local/share/valo-skin/agent-art/, for your own desktop. The shell then shows the current
agent's portrait over the wallpaper, and the login screen picks it up on the next
`./install.sh --sddm`.

    valo-agent-art              # download anything missing
    valo-agent-art --force      # re-download everything
    valo-agent-art --only jett,yoru
    valo-agent-art --remove     # delete the downloaded art

Valorant and all agent artwork are trademarks and copyright of Riot Games, Inc. Used under Riot's
"Legal Jibber Jabber" policy for non-commercial fan content; not endorsed by Riot.
"""

import argparse
import json
import os
import shutil
import sys
import urllib.request
from pathlib import Path

API = "https://valorant-api.com/v1/agents?isPlayableCharacter=true"
AGENTS = ("astra breach brimstone chamber clove cypher deadlock fade gekko harbor iso jett kayo killjoy neon omen "
          "phoenix raze reyna sage skye sova tejo viper vyse waylay yoru").split()
UA = {"User-Agent": "valo-skin/1.0 (+https://github.com/aditya36900/Valo-skin)"}


def art_dir() -> Path:
    base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    return Path(base) / "valo-skin" / "agent-art"


def agent_id(display_name: str) -> str:
    return "".join(c for c in display_name.lower() if c.isalnum())  # "KAY/O" -> "kayo"


def fetch(url: str, timeout: int = 30) -> bytes:
    req = urllib.request.Request(url, headers=UA)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read()


def save(url: str, dest: Path) -> None:
    tmp = dest.with_suffix(dest.suffix + ".part")
    tmp.write_bytes(fetch(url))
    tmp.replace(dest)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--api", default=API, help="agents endpoint (for testing)")
    ap.add_argument("--dir", type=Path, default=art_dir(), help="where to store the art")
    ap.add_argument("--only", default="", help="comma-separated agent ids")
    ap.add_argument("--force", action="store_true", help="re-download existing files")
    ap.add_argument("--remove", action="store_true", help="delete downloaded art and exit")
    args = ap.parse_args()

    if args.remove:
        shutil.rmtree(args.dir, ignore_errors=True)
        print(f"removed {args.dir}")
        return 0

    wanted = {a.strip() for a in args.only.split(",") if a.strip()} or set(AGENTS)
    try:
        data = json.loads(fetch(args.api))["data"]
    except Exception as e:  # noqa: BLE001 - network errors come in many shapes
        print(f"valo-agent-art: couldn't reach {args.api}: {e}", file=sys.stderr)
        return 1

    args.dir.mkdir(parents=True, exist_ok=True)
    got, failed, skipped = [], [], []
    index = {}
    for agent in data:
        aid = agent_id(agent.get("displayName", ""))
        if aid not in wanted:
            continue
        portrait = agent.get("fullPortrait") or agent.get("fullPortraitV2") or agent.get("displayIcon")
        files = {f"{aid}.png": portrait, f"{aid}-name.png": agent.get("background")}
        index[aid] = {"name": agent.get("displayName"), "role": (agent.get("role") or {}).get("displayName")}
        for name, url in files.items():
            dest = args.dir / name
            if not url:
                continue
            if dest.exists() and not args.force:
                skipped.append(name)
                continue
            try:
                save(url, dest)
                got.append(name)
            except Exception as e:  # noqa: BLE001
                failed.append(f"{name} ({e})")

    (args.dir / "index.json").write_text(json.dumps(index, indent=2) + "\n")
    missing = sorted(wanted - set(index))
    print(f"valo-agent-art: {len(got)} downloaded, {len(skipped)} already there -> {args.dir}")
    if missing:
        print("  not in the API (yet): " + ", ".join(missing))
    for f in failed:
        print("  failed: " + f, file=sys.stderr)
    return 1 if failed and not got and not skipped else 0


if __name__ == "__main__":
    sys.exit(main())
