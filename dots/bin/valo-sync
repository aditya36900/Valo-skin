#!/usr/bin/env python3
"""valo-sync: apply the current Valo-skin agent colours to the rest of the desktop.

Reads the scheme the shell publishes to ~/.local/state/caelestia/valorant-scheme.json
(falls back to computing the default Valorant scheme) and writes colour files for:

  Hyprland (Lua + hyprlang), kitty, foot, alacritty, fastfetch, GTK 3/4, qt5ct/qt6ct,
  the Valo-Crosshair cursor accent, and (when installed) btop, Neovim, VS Code / VSCodium,
  Firefox (opted-in profiles), Vesktop / Vencord and Spicetify.

Each target only gets a small *include* file; your own configs are never rewritten
(install.sh adds the one include line per app). Files are only touched when their
content changes, and apps are only reloaded when something changed.

Usage: valo-sync [--quiet] [--dry-run] [--accent '#rrggbb'] [--light] [--only kitty,hypr,...]
"""

import argparse
import colorsys
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
XDG_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
XDG_STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state")
XDG_DATA = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")
SCHEME_FILE = XDG_STATE / "caelestia" / "valorant-scheme.json"
SHARE_DIR = XDG_DATA / "valo-skin"

TARGETS = ["hypr", "kitty", "foot", "alacritty", "fastfetch", "gtk", "qt", "cursor",
           "btop", "nvim", "vscode", "firefox", "discord", "spicetify"]

# ---------------------------------------------------------------- colour maths


def parse(c: str):
    c = c.lstrip("#")
    return tuple(int(c[i:i + 2], 16) / 255 for i in (0, 2, 4))


def to_hex(rgb) -> str:
    # Match the shell: QColor keeps 16-bit channels, then QML rounds half up to 8 bits
    def q(v):
        v16 = int(max(0.0, min(1.0, v)) * 65535 + 0.5 + 1e-7)
        return int(v16 / 65535 * 255 + 0.5)

    return "".join(f"{q(v):02x}" for v in rgb)


def mix(a, b, t):
    return tuple(x + (y - x) * t for x, y in zip(a, b))


def lighter(c, f):
    # Same semantics as QColor::lighter (HSV value scale, desaturate on overflow)
    h, s, v = colorsys.rgb_to_hsv(*c)
    v *= f
    if v > 1:
        s = max(0.0, s - (v - 1))
        v = 1.0
    return colorsys.hsv_to_rgb(h, s, v)


def builtin_scheme(accent="#ff4655", light=False):
    """Python port of Valorant.scheme() for when the shell hasn't published one yet."""
    red, navy, white = parse("#ff4655"), parse("#0f1923"), parse("#ece8e1")
    teal, gold = parse("#17d1a6"), parse("#e8c06a")
    bg, fg = (white, navy) if light else (navy, white)
    a = parse(accent)
    b = fg if to_hex(a) == to_hex(red) else red

    def step(t):
        return mix(bg, fg, t)

    def on(c):
        return navy if 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2] > 0.45 else white

    c = {
        "background": bg, "surface": bg, "onSurface": fg, "onBackground": fg,
        "surfaceContainerLow": step(0.04), "surfaceContainer": step(0.07),
        "surfaceContainerHigh": step(0.11), "surfaceContainerHighest": step(0.15),
        "surfaceVariant": step(0.18), "onSurfaceVariant": step(0.72),
        "outline": step(0.42), "outlineVariant": step(0.22),
        "primary": a, "onPrimary": on(a), "primaryContainer": mix(bg, a, 0.32),
        "onPrimaryContainer": mix(a, navy, 0.6) if light else mix(a, white, 0.7),
        "secondary": b, "onSecondary": on(b), "secondaryContainer": mix(bg, b, 0.25),
        "tertiary": gold, "onTertiary": on(gold),
        "error": parse("#d6283a") if light else parse("#ff5c6c"),
        "errorContainer": mix(bg, red, 0.35), "success": teal,
        "term0": mix(white, navy, 0.85) if light else mix(navy, white, 0.12),
        "term1": red, "term2": teal, "term3": gold, "term4": parse("#4a8dff"),
        "term5": parse("#b44dff"), "term6": parse("#3fe0c5"), "term7": navy if light else white,
        "term8": step(0.4), "term9": lighter(red, 1.15), "term10": lighter(teal, 1.2),
        "term11": lighter(gold, 1.15), "term12": parse("#7fb0ff"), "term13": parse("#cf8aff"),
        "term14": parse("#8af0dc"), "term15": parse("#ffffff"),
    }
    return {
        "name": "valorant", "flavour": "custom", "agentName": "Valorant", "role": "",
        "mode": "light" if light else "dark", "chamfer": 10,
        "colours": {k: to_hex(v) for k, v in c.items()},
    }


def load_scheme(args):
    if args.accent:
        return builtin_scheme(args.accent, args.light)
    try:
        data = json.loads(SCHEME_FILE.read_text())
        if "colours" in data:
            return data
    except (OSError, ValueError):
        pass
    return builtin_scheme(light=args.light)


# ---------------------------------------------------------------- renderers


class Palette:
    def __init__(self, scheme):
        self.s = scheme
        self.c = scheme["colours"]
        self.light = scheme.get("mode") == "light"

    def __getattr__(self, k):
        return self.c[k]

    def h(self, k):
        return "#" + self.c[k]

    def term(self, i):
        return self.c[f"term{i}"]

    def ansi(self, k):
        r, g, b = (round(v * 255) for v in parse(self.c[k]))
        return f"38;2;{r};{g};{b}"


HEADER = "Generated by valo-sync for agent {agent}. Do not edit: changes are overwritten."


def header(p, comment="#"):
    return f"{comment} {HEADER.format(agent=p.s.get('agentName', p.s.get('flavour', '?')))}\n"


def render_hypr(p):
    lua = header(p, "--") + f"""return {{
    accent = "{p.primary}",
    red = "{p.term1}",
    background = "{p.background}",
    surface = "{p.surfaceContainer}",
    outline = "{p.outlineVariant}",
    active_border = {{ colors = {{ "rgba({p.primary}ff)", "rgba({p.term1}ff)" }}, angle = 45 }},
    inactive_border = "rgba({p.outlineVariant}cc)",
    group_active = "rgba({p.primary}ff)",
    group_inactive = "rgba({p.surfaceContainerHigh}ff)",
    shadow = "rgba({p.background}cc)",
}}
"""
    conf = header(p) + f"""$valoAccent = rgba({p.primary}ff)
$valoRed = rgba({p.term1}ff)
$valoBackground = rgba({p.background}ff)
$valoSurface = rgba({p.surfaceContainer}ff)
$valoOutline = rgba({p.outlineVariant}cc)
$valoShadow = rgba({p.background}cc)
"""
    return {XDG_CONFIG / "hypr/valorant-colors.lua": lua, XDG_CONFIG / "hypr/valorant-colors.conf": conf}


def render_kitty(p):
    lines = [header(p).rstrip(),
             f"foreground {p.h('onSurface')}", f"background {p.h('background')}",
             f"selection_foreground {p.h('onPrimaryContainer')}", f"selection_background {p.h('primaryContainer')}",
             f"cursor {p.h('primary')}", f"cursor_text_color {p.h('background')}",
             f"url_color {p.h('primary')}",
             f"active_border_color {p.h('primary')}", f"inactive_border_color {p.h('outlineVariant')}",
             f"bell_border_color {p.h('term1')}",
             f"active_tab_foreground {p.h('onPrimary')}", f"active_tab_background {p.h('primary')}",
             f"inactive_tab_foreground {p.h('onSurfaceVariant')}", f"inactive_tab_background {p.h('surfaceContainer')}",
             f"tab_bar_background {p.h('background')}",
             f"mark1_background {p.h('primary')}", f"mark2_background {p.h('term1')}", f"mark3_background {p.h('tertiary')}"]
    lines += [f"color{i} #{p.term(i)}" for i in range(16)]
    return {XDG_CONFIG / "kitty/valorant.conf": "\n".join(lines) + "\n"}


def render_foot(p):
    names = ["regular", "bright"]
    lines = [header(p).rstrip(), "[colors]", f"foreground={p.onSurface}", f"background={p.background}",
             f"selection-foreground={p.onPrimaryContainer}", f"selection-background={p.primaryContainer}",
             f"cursor={p.background} {p.primary}", f"urls={p.primary}"]
    for n, base in zip(names, (0, 8)):
        lines += [f"{n}{i}={p.term(base + i)}" for i in range(8)]
    return {XDG_CONFIG / "foot/valorant.ini": "\n".join(lines) + "\n"}


def render_alacritty(p):
    keys = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
    out = [header(p).rstrip(),
           "[colors.primary]", f'background = "{p.h("background")}"', f'foreground = "{p.h("onSurface")}"', "",
           "[colors.cursor]", f'text = "{p.h("background")}"', f'cursor = "{p.h("primary")}"', "",
           "[colors.selection]", f'text = "{p.h("onPrimaryContainer")}"', f'background = "{p.h("primaryContainer")}"', ""]
    for sec, base in (("normal", 0), ("bright", 8)):
        out.append(f"[colors.{sec}]")
        out += [f'{k} = "#{p.term(base + i)}"' for i, k in enumerate(keys)]
        out.append("")
    return {XDG_CONFIG / "alacritty/valorant.toml": "\n".join(out)}


FASTFETCH_LOGO = """$1 ╱━━━━               ━━━━╲
$1┃                         ┃
$1┃            $2┃$1            ┃
$1┃            $2┃$1            ┃
$1┃    $2━━━━━   ■   ━━━━━$1    ┃
$1┃            $2┃$1            ┃
$1┃            $2┃$1            ┃
$1┃                         ┃
$1 ╲━━━━               ━━━━╱
"""


def render_fastfetch(p):
    logo = SHARE_DIR / "fastfetch-logo.txt"
    cfg = {
        "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
        "logo": {"type": "file", "source": str(logo), "color": {"1": p.ansi("onSurface"), "2": p.ansi("primary")},
                 "padding": {"top": 1, "right": 3}},
        "display": {"separator": "  ", "color": {"keys": p.ansi("primary"), "title": p.ansi("term1")},
                    "key": {"width": 12}},
        "modules": [
            {"type": "title", "format": "{user-name}  //  {host-name}"},
            {"type": "custom", "format": f"\u001b[{p.ansi('outline')}m" + "─" * 34},
            {"type": "custom", "key": "AGENT", "format": f"{p.s.get('agentName', 'Valorant').upper()}  {p.s.get('role', '').upper()}"},
            {"type": "os", "key": "OS"},
            {"type": "kernel", "key": "KERNEL"},
            {"type": "wm", "key": "WM"},
            {"type": "uptime", "key": "MATCH TIME"},
            {"type": "packages", "key": "LOADOUT"},
            {"type": "cpu", "key": "CPU"},
            {"type": "gpu", "key": "GPU"},
            {"type": "memory", "key": "MEMORY"},
            {"type": "terminal", "key": "TERMINAL"},
            "break",
            {"type": "colors", "symbol": "block"},
        ],
    }
    return {
        logo: FASTFETCH_LOGO,
        XDG_CONFIG / "fastfetch/valorant.jsonc": "// " + HEADER.format(agent=p.s.get("agentName", "?")) + "\n"
        + json.dumps(cfg, indent=2) + "\n",
    }


def render_gtk(p):
    css = header(p, "/*").rstrip() + " */\n" + "\n".join(f"@define-color {k} {v};" for k, v in [
        ("accent_color", p.h("primary")), ("accent_bg_color", p.h("primary")), ("accent_fg_color", p.h("onPrimary")),
        ("destructive_color", p.h("error")), ("destructive_bg_color", p.h("errorContainer")),
        ("destructive_fg_color", p.h("onSurface")),
        ("success_color", p.h("success")), ("warning_color", p.h("tertiary")), ("error_color", p.h("error")),
        ("window_bg_color", p.h("background")), ("window_fg_color", p.h("onSurface")),
        ("view_bg_color", p.h("surfaceContainerLow")), ("view_fg_color", p.h("onSurface")),
        ("headerbar_bg_color", p.h("surfaceContainer")), ("headerbar_fg_color", p.h("onSurface")),
        ("headerbar_backdrop_color", p.h("background")),
        ("sidebar_bg_color", p.h("surfaceContainer")), ("sidebar_fg_color", p.h("onSurface")),
        ("secondary_sidebar_bg_color", p.h("surfaceContainerLow")),
        ("card_bg_color", p.h("surfaceContainer")), ("card_fg_color", p.h("onSurface")),
        ("dialog_bg_color", p.h("surfaceContainerHigh")), ("dialog_fg_color", p.h("onSurface")),
        ("popover_bg_color", p.h("surfaceContainerHigh")), ("popover_fg_color", p.h("onSurface")),
        ("thumbnail_bg_color", p.h("surfaceContainerHigh")), ("borders", p.h("outlineVariant")),
    ]) + "\n\n/* Sharp HUD corners */\nwindow, .background, button, entry, popover contents, .card { border-radius: 0; }\n"
    return {XDG_CONFIG / "gtk-3.0/valorant.css": css, XDG_CONFIG / "gtk-4.0/valorant.css": css}


def render_qt(p):
    # QPalette role order used by qt5ct/qt6ct colour schemes
    roles = [p.onSurface, p.surfaceContainerHigh, p.surfaceContainerHighest, p.surfaceContainerHigh, p.background,
             p.surfaceContainer, p.onSurface, p.term15, p.onSurface, p.surfaceContainerLow, p.background, "000000",
             p.primary, p.onPrimary, p.primary, p.term5, p.surfaceContainer, "000000", p.surfaceContainerHighest,
             p.onSurface, p.outline]
    active = ", ".join(f"#ff{c}" for c in roles)
    dim = list(roles)
    for i in (0, 6, 8):
        dim[i] = p.outline
    disabled = ", ".join(f"#ff{c}" for c in dim)
    body = f"{header(p)}[ColorScheme]\nactive_colors={active}\ninactive_colors={active}\ndisabled_colors={disabled}\n"
    return {XDG_CONFIG / "qt5ct/colors/valorant.conf": body, XDG_CONFIG / "qt6ct/colors/valorant.conf": body}


def render_cursor(p):
    # Picked up by install.sh / valo-cursors to tint the Valo-Crosshair theme
    return {SHARE_DIR / "cursor-accent": p.primary + "\n"}


def have(*cmds):
    return any(shutil.which(c) for c in cmds)


def render_btop(p):
    if not (have("btop") or (XDG_CONFIG / "btop").exists()):
        return {}
    c = p.h
    keys = {
        "main_bg": c("background"), "main_fg": c("onSurface"), "title": c("onSurface"), "hi_fg": c("primary"),
        "selected_bg": c("primaryContainer"), "selected_fg": c("onPrimaryContainer"), "inactive_fg": c("outline"),
        "graph_text": c("onSurfaceVariant"), "meter_bg": c("surfaceContainerHigh"), "proc_misc": c("primary"),
        "cpu_box": c("primary"), "mem_box": c("term1"), "net_box": c("success"), "proc_box": c("outline"),
        "div_line": c("outlineVariant"),
        "temp_start": c("success"), "temp_mid": c("tertiary"), "temp_end": c("term1"),
        "cpu_start": c("primary"), "cpu_mid": c("tertiary"), "cpu_end": c("term1"),
        "free_start": c("success"), "free_mid": c("success"), "free_end": c("term10"),
        "cached_start": c("term4"), "cached_mid": c("term4"), "cached_end": c("term12"),
        "available_start": c("tertiary"), "available_mid": c("tertiary"), "available_end": c("term11"),
        "used_start": c("term1"), "used_mid": c("term1"), "used_end": c("term9"),
        "download_start": c("primary"), "download_mid": c("primary"), "download_end": c("onSurface"),
        "upload_start": c("term1"), "upload_mid": c("term1"), "upload_end": c("onSurface"),
        "process_start": c("primary"), "process_mid": c("tertiary"), "process_end": c("term1"),
    }
    body = header(p) + "".join(f'theme[{k}]="{v}"\n' for k, v in keys.items())
    return {XDG_CONFIG / "btop/themes/valorant.theme": body}


def render_nvim(p):
    if not have("nvim"):
        return {}
    c = p.h
    groups = {
        "Normal": {"fg": c("onSurface"), "bg": c("background")},
        "NormalFloat": {"fg": c("onSurface"), "bg": c("surfaceContainer")},
        "FloatBorder": {"fg": c("primary"), "bg": c("surfaceContainer")},
        "FloatTitle": {"fg": c("primary"), "bg": c("surfaceContainer"), "bold": True},
        "Cursor": {"fg": c("background"), "bg": c("primary")},
        "CursorLine": {"bg": c("surfaceContainerLow")},
        "CursorColumn": {"bg": c("surfaceContainerLow")},
        "ColorColumn": {"bg": c("surfaceContainerLow")},
        "Visual": {"bg": c("primaryContainer")},
        "LineNr": {"fg": c("outline")},
        "CursorLineNr": {"fg": c("primary"), "bold": True},
        "SignColumn": {"bg": c("background")},
        "WinSeparator": {"fg": c("outlineVariant")},
        "StatusLine": {"fg": c("onSurface"), "bg": c("surfaceContainerHigh")},
        "StatusLineNC": {"fg": c("outline"), "bg": c("surfaceContainer")},
        "TabLine": {"fg": c("outline"), "bg": c("surfaceContainer")},
        "TabLineSel": {"fg": c("onPrimary"), "bg": c("primary"), "bold": True},
        "TabLineFill": {"bg": c("background")},
        "Pmenu": {"fg": c("onSurface"), "bg": c("surfaceContainer")},
        "PmenuSel": {"fg": c("onPrimary"), "bg": c("primary")},
        "PmenuSbar": {"bg": c("surfaceContainerHigh")},
        "PmenuThumb": {"bg": c("outline")},
        "Search": {"fg": c("background"), "bg": c("tertiary")},
        "IncSearch": {"fg": c("background"), "bg": c("term1")},
        "CurSearch": {"fg": c("background"), "bg": c("term1")},
        "MatchParen": {"fg": c("primary"), "bold": True, "underline": True},
        "Title": {"fg": c("primary"), "bold": True},
        "Directory": {"fg": c("primary")},
        "NonText": {"fg": c("outlineVariant")},
        "Whitespace": {"fg": c("outlineVariant")},
        "Comment": {"fg": c("outline"), "italic": True},
        "Constant": {"fg": c("tertiary")},
        "String": {"fg": c("success")},
        "Character": {"fg": c("success")},
        "Number": {"fg": c("tertiary")},
        "Boolean": {"fg": c("tertiary"), "bold": True},
        "Identifier": {"fg": c("onSurface")},
        "Function": {"fg": c("primary")},
        "Statement": {"fg": c("term1")},
        "Keyword": {"fg": c("term1"), "bold": True},
        "Operator": {"fg": c("onSurfaceVariant")},
        "PreProc": {"fg": c("term5")},
        "Type": {"fg": c("term6")},
        "Special": {"fg": c("term5")},
        "Delimiter": {"fg": c("onSurfaceVariant")},
        "Todo": {"fg": c("background"), "bg": c("tertiary"), "bold": True},
        "Error": {"fg": c("error")},
        "ErrorMsg": {"fg": c("error"), "bold": True},
        "WarningMsg": {"fg": c("tertiary")},
        "DiagnosticError": {"fg": c("error")},
        "DiagnosticWarn": {"fg": c("tertiary")},
        "DiagnosticInfo": {"fg": c("term4")},
        "DiagnosticHint": {"fg": c("success")},
        "DiagnosticUnderlineError": {"sp": c("error"), "undercurl": True},
        "DiagnosticUnderlineWarn": {"sp": c("tertiary"), "undercurl": True},
        "DiffAdd": {"bg": c("successContainer") if "successContainer" in p.c else c("surfaceContainerHigh")},
        "DiffChange": {"bg": c("surfaceContainerHigh")},
        "DiffDelete": {"fg": c("term1"), "bg": c("errorContainer")},
        "DiffText": {"bg": c("primaryContainer")},
        "@variable": {"link": "Identifier"},
        "@keyword": {"link": "Keyword"},
        "@function": {"link": "Function"},
        "@function.builtin": {"fg": c("primary"), "italic": True},
        "@type": {"link": "Type"},
        "@string": {"link": "String"},
        "@comment": {"link": "Comment"},
        "@property": {"fg": c("onSurfaceVariant")},
        "@punctuation": {"link": "Delimiter"},
    }

    def lua(v):
        if isinstance(v, bool):
            return "true" if v else "false"
        return f'"{v}"'
    lines = [header(p, "--").rstrip(),
             "-- Enable with :colorscheme valorant (valo-sync re-applies it live on agent switch)",
             "vim.cmd('highlight clear')", "if vim.fn.exists('syntax_on') == 1 then vim.cmd('syntax reset') end",
             "vim.o.termguicolors = true", f"vim.o.background = '{'light' if p.light else 'dark'}'",
             "vim.g.colors_name = 'valorant'", "local hl = function(g, o) vim.api.nvim_set_hl(0, g, o) end"]
    for g, o in groups.items():
        lines.append(f'hl("{g}", {{ ' + ", ".join(f"{k} = {lua(v)}" for k, v in o.items()) + " })")
    for i in range(16):
        lines.append(f'vim.g.terminal_color_{i} = "#{p.term(i)}"')
    return {XDG_CONFIG / "nvim/colors/valorant.lua": "\n".join(lines) + "\n"}


VSCODE_EXT = "valo-skin.valorant-theme-1.0.0"


def render_vscode(p):
    # Extensions dir per editor, detected by either the extensions home or the config dir
    editors = {".vscode": ["Code"], ".vscode-oss": ["Code - OSS", "VSCodium"], ".vscode-insiders": ["Code - Insiders"],
               ".cursor": ["Cursor"], ".windsurf": ["Windsurf"]}
    roots = [HOME / d / "extensions" for d, cfgs in editors.items()
             if (HOME / d).exists() or any((XDG_CONFIG / c).exists() for c in cfgs)]
    if not roots and have("code", "codium", "code-oss"):
        roots = [HOME / ".vscode" / "extensions"]
    if not roots:
        return {}
    c = p.h
    colors = {
        "focusBorder": c("primary"), "foreground": c("onSurface"), "descriptionForeground": c("onSurfaceVariant"),
        "errorForeground": c("error"), "selection.background": c("primaryContainer"),
        "editor.background": c("background"), "editor.foreground": c("onSurface"),
        "editor.lineHighlightBackground": c("surfaceContainerLow"),
        "editor.selectionBackground": c("primaryContainer"), "editor.findMatchBackground": c("tertiary") + "66",
        "editorCursor.foreground": c("primary"), "editorLineNumber.foreground": c("outline"),
        "editorLineNumber.activeForeground": c("primary"), "editorIndentGuide.background1": c("outlineVariant"),
        "editorBracketMatch.border": c("primary"), "editorWidget.background": c("surfaceContainer"),
        "editorWidget.border": c("outlineVariant"), "editorSuggestWidget.selectedBackground": c("primaryContainer"),
        "editorGroupHeader.tabsBackground": c("background"), "editorGroup.border": c("outlineVariant"),
        "tab.activeBackground": c("surfaceContainer"), "tab.activeForeground": c("onSurface"),
        "tab.activeBorderTop": c("primary"), "tab.inactiveBackground": c("background"),
        "tab.inactiveForeground": c("outline"), "tab.border": c("background"),
        "activityBar.background": c("background"), "activityBar.foreground": c("onSurface"),
        "activityBar.inactiveForeground": c("outline"), "activityBar.activeBorder": c("primary"),
        "activityBarBadge.background": c("term1"), "activityBarBadge.foreground": c("onSurface"),
        "sideBar.background": c("surfaceContainerLow"), "sideBar.foreground": c("onSurfaceVariant"),
        "sideBar.border": c("outlineVariant"), "sideBarSectionHeader.background": c("surfaceContainer"),
        "sideBarTitle.foreground": c("onSurface"), "list.activeSelectionBackground": c("primaryContainer"),
        "list.activeSelectionForeground": c("onPrimaryContainer"), "list.hoverBackground": c("surfaceContainer"),
        "list.highlightForeground": c("primary"), "statusBar.background": c("surfaceContainer"),
        "statusBar.foreground": c("onSurfaceVariant"), "statusBar.border": c("primary"),
        "statusBarItem.remoteBackground": c("term1"), "statusBarItem.remoteForeground": c("onSurface"),
        "titleBar.activeBackground": c("background"), "titleBar.activeForeground": c("onSurface"),
        "panel.background": c("background"), "panel.border": c("outlineVariant"),
        "panelTitle.activeBorder": c("primary"), "terminal.background": c("background"),
        "terminal.foreground": c("onSurface"), "terminalCursor.foreground": c("primary"),
        "button.background": c("primary"), "button.foreground": c("onPrimary"),
        "button.secondaryBackground": c("surfaceContainerHigh"), "input.background": c("surfaceContainer"),
        "input.border": c("outlineVariant"), "badge.background": c("primary"), "badge.foreground": c("onPrimary"),
        "progressBar.background": c("primary"), "scrollbarSlider.background": c("outline") + "55",
        "notifications.background": c("surfaceContainer"), "notificationsErrorIcon.foreground": c("error"),
        "gitDecoration.addedResourceForeground": c("success"), "gitDecoration.modifiedResourceForeground": c("tertiary"),
        "gitDecoration.deletedResourceForeground": c("term1"),
    }
    names = ["Black", "Red", "Green", "Yellow", "Blue", "Magenta", "Cyan", "White"]
    for i, n in enumerate(names):
        colors[f"terminal.ansi{n}"] = "#" + p.term(i)
        colors[f"terminal.ansiBright{n}"] = "#" + p.term(i + 8)

    def tok(scope, fg, style=None):
        s = {"foreground": fg}
        if style:
            s["fontStyle"] = style
        return {"scope": scope, "settings": s}
    tokens = [
        tok(["comment", "punctuation.definition.comment"], c("outline"), "italic"),
        tok(["string", "string.quoted"], c("success")),
        tok(["constant.numeric", "constant.language", "constant.character"], c("tertiary")),
        tok(["keyword", "storage", "storage.type", "keyword.control"], c("term1"), "bold"),
        tok(["keyword.operator", "punctuation"], c("onSurfaceVariant")),
        tok(["entity.name.function", "support.function", "meta.function-call"], c("primary")),
        tok(["entity.name.type", "entity.name.class", "support.type", "support.class"], c("term6")),
        tok(["variable", "meta.definition.variable"], c("onSurface")),
        tok(["variable.parameter"], c("onSurfaceVariant"), "italic"),
        tok(["entity.other.attribute-name", "meta.object-literal.key"], c("onSurfaceVariant")),
        tok(["entity.name.tag"], c("term1")),
        tok(["meta.decorator", "entity.name.function.decorator", "keyword.other.special-method"], c("term5")),
        tok(["markup.heading"], c("primary"), "bold"),
        tok(["markup.inserted"], c("success")), tok(["markup.deleted"], c("term1")),
        tok(["invalid"], c("error")),
    ]
    theme = {"name": "Valorant (Valo-skin)", "type": "light" if p.light else "dark",
             "semanticHighlighting": True, "colors": colors, "tokenColors": tokens}
    pkg = {
        "name": "valorant-theme", "displayName": "Valorant (Valo-skin)", "publisher": "valo-skin",
        "version": "1.0.0", "description": "Generated by valo-sync for the current Valo-skin agent",
        "engines": {"vscode": "^1.70.0"}, "categories": ["Themes"],
        "contributes": {"themes": [{"label": "Valorant (Valo-skin)", "uiTheme": "vs" if p.light else "vs-dark",
                                    "path": "./themes/valorant-color-theme.json"}]},
    }
    out = {}
    for root in roots:
        out[root / VSCODE_EXT / "package.json"] = json.dumps(pkg, indent=2) + "\n"
        out[root / VSCODE_EXT / "themes/valorant-color-theme.json"] = json.dumps(theme, indent=2) + "\n"
    return out


def firefox_profiles():
    """Profiles opted in by install.sh --firefox (they contain chrome/.valo-skin)."""
    out = []
    for base in (HOME / ".mozilla/firefox", HOME / ".librewolf", HOME / ".zen"):
        if base.exists():
            out += [d for d in base.iterdir() if (d / "chrome" / ".valo-skin").exists()]
    return out


def render_firefox(p):
    profiles = firefox_profiles()
    if not profiles:
        return {}
    c = p.h
    css = header(p, "/*").rstrip() + " */\n:root {\n" + "".join(f"  --valo-{k}: {v};\n" for k, v in {
        "bg": c("background"), "surface": c("surfaceContainer"), "surface-high": c("surfaceContainerHigh"),
        "fg": c("onSurface"), "muted": c("outline"), "border": c("outlineVariant"), "accent": c("primary"),
        "on-accent": c("onPrimary"), "red": c("term1"),
    }.items()) + "}\n"
    return {d / "chrome/valorant-colors.css": css for d in profiles}


def render_discord(p):
    dirs = [XDG_CONFIG / d / "themes" for d in ("vesktop", "Vencord", "equibop") if (XDG_CONFIG / d).exists()]
    if not dirs:
        return {}
    c = p.h
    vars_ = {
        # Legacy and visual-refresh variable names
        "--background-primary": c("background"), "--background-secondary": c("surfaceContainerLow"),
        "--background-secondary-alt": c("surfaceContainer"), "--background-tertiary": c("surfaceContainerLow"),
        "--background-floating": c("surfaceContainerHigh"), "--background-accent": c("primary"),
        "--background-base-lowest": c("surfaceContainerLow"), "--background-base-lower": c("background"),
        "--background-base-low": c("surfaceContainerLow"), "--background-surface-high": c("surfaceContainerHigh"),
        "--background-modifier-hover": c("surfaceContainer"), "--background-modifier-selected": c("primaryContainer"),
        "--channeltextarea-background": c("surfaceContainer"), "--chat-background-default": c("background"),
        "--text-normal": c("onSurface"), "--text-default": c("onSurface"), "--text-muted": c("outline"),
        "--header-primary": c("onSurface"), "--header-secondary": c("onSurfaceVariant"),
        "--interactive-normal": c("onSurfaceVariant"), "--interactive-hover": c("onSurface"),
        "--interactive-active": c("primary"), "--text-link": c("primary"), "--brand-500": c("primary"),
        "--brand-experiment": c("primary"), "--border-subtle": c("outlineVariant"), "--status-danger": c("term1"),
        "--status-positive": c("success"), "--status-warning": c("tertiary"),
    }
    css = ("/**\n * @name Valorant (Valo-skin)\n * @description Generated by valo-sync for the current agent\n"
           " * @author Valo-skin\n * @version 1.0.0\n */\n"
           ":root, .theme-dark, .theme-light, .visual-refresh {\n" + "".join(f"  {k}: {v} !important;\n" for k, v in vars_.items())
           + "}\n/* Sharp HUD corners */\n[class*='message'], [class*='button'], [class*='modal'], [class*='popout'] { border-radius: 0 !important; }\n")
    return {d / "valorant.theme.css": css for d in dirs}


def render_spicetify(p):
    base = XDG_CONFIG / "spicetify"
    if not base.exists():
        return {}
    k = {
        "text": p.onSurface, "subtext": p.onSurfaceVariant, "main": p.background, "main-elevated": p.surfaceContainer,
        "sidebar": p.surfaceContainerLow, "player": p.surfaceContainerLow, "card": p.surfaceContainer,
        "shadow": "000000", "selected-row": p.onSurfaceVariant, "button": p.primary, "button-active": p.primary,
        "button-disabled": p.outline, "tab-active": p.surfaceContainerHigh, "notification": p.primary,
        "notification-error": p.term1, "misc": p.outline, "highlight": p.surfaceContainerHigh,
        "highlight-elevated": p.surfaceContainerHighest,
    }
    ini = header(p, ";") + "[agent]\n" + "".join(f"{key:<20}= {v}\n" for key, v in k.items())
    css = header(p, "/*").rstrip() + " */\n* { border-radius: 0 !important; }\n" \
        ".main-nowPlayingBar-container { border-top: 2px solid var(--spice-button) !important; }\n"
    return {base / "Themes/Valorant/color.ini": ini, base / "Themes/Valorant/user.css": css}


RENDERERS = {
    "hypr": render_hypr, "kitty": render_kitty, "foot": render_foot, "alacritty": render_alacritty,
    "fastfetch": render_fastfetch, "gtk": render_gtk, "qt": render_qt, "cursor": render_cursor,
    "btop": render_btop, "nvim": render_nvim, "vscode": render_vscode, "firefox": render_firefox,
    "discord": render_discord, "spicetify": render_spicetify,
}

# ---------------------------------------------------------------- reloads


def run(cmd):
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10, check=False)
    except (OSError, subprocess.SubprocessError):
        pass


def reload(changed):
    if "hypr" in changed and shutil.which("hyprctl") and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        run(["hyprctl", "reload"])
    if "kitty" in changed and shutil.which("pkill"):
        run(["pkill", "-USR1", "-x", "kitty"])  # kitty reloads its config on SIGUSR1
    if "foot" in changed and shutil.which("pkill"):
        run(["pkill", "-USR1", "-x", "foot"])  # foot >= 1.15 switches/reloads colours on SIGUSR1
    if "btop" in changed and shutil.which("pkill"):
        run(["pkill", "-USR2", "-x", "btop"])  # btop reloads its config/theme on SIGUSR2
    if "nvim" in changed:
        runtime = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
        for sock in list(runtime.glob("nvim.*.0")) + list(Path("/tmp").glob("nvim.*/0")):
            run(["nvim", "--server", str(sock), "--remote-expr",
                 "execute('if get(g:, \"colors_name\", \"\") ==# \"valorant\" | colorscheme valorant | endif')"])
    if "spicetify" in changed and shutil.which("spicetify"):
        cfg = XDG_CONFIG / "spicetify/config-xpui.ini"
        if cfg.exists() and "current_theme = Valorant" in cfg.read_text():
            run(["spicetify", "refresh", "-s"])
    if "cursor" in changed:
        gen = Path(__file__).with_name("valo-cursors")
        if gen.exists():
            run([sys.executable, str(gen), "--quiet"])


# ---------------------------------------------------------------- main


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--quiet", action="store_true")
    ap.add_argument("--dry-run", action="store_true", help="print what would change")
    ap.add_argument("--accent", help="ignore the shell and use this accent")
    ap.add_argument("--light", action="store_true", help="with --accent or no published scheme: light mode")
    ap.add_argument("--only", help="comma-separated targets: " + ",".join(TARGETS))
    ap.add_argument("--print", action="store_true", help="print the scheme JSON and exit")
    args = ap.parse_args()

    scheme = load_scheme(args)
    if args.print:
        print(json.dumps(scheme, indent=2))
        return 0

    p = Palette(scheme)
    wanted = args.only.split(",") if args.only else TARGETS
    changed = set()
    for name in wanted:
        if name not in RENDERERS:
            print(f"valo-sync: unknown target {name!r}", file=sys.stderr)
            return 2
        for path, content in RENDERERS[name](p).items():
            try:
                if path.read_text() == content:
                    continue
            except OSError:
                pass
            changed.add(name)
            if args.dry_run:
                print(f"would write {path}")
                continue
            path.parent.mkdir(parents=True, exist_ok=True)
            tmp = path.with_suffix(path.suffix + ".tmp")
            tmp.write_text(content)
            tmp.replace(path)
            if not args.quiet:
                print(f"wrote {path}")

    if not args.dry_run:
        reload(changed)
    if not args.quiet:
        agent = scheme.get("agentName", scheme.get("flavour"))
        print(f"valo-sync: {agent} applied ({', '.join(sorted(changed)) or 'nothing changed'})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
